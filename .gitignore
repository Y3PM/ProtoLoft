# 操作系统与编辑器临时文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# 本地调试与审计状态目录
.mimosa/
*.log
*.tmp

# 共享开发资料保留在 Git，仅忽略生成缓存与本地临时产物
.dev/**/__pycache__/
.dev/**/*.py[cod]
.dev/tmp/
.dev/screenshots/

# 私有服务器部署与运维记录（包含特定服务器与内网环境，禁止公开）
.dev/docs/deployments/

# 老版本历史备份禁止上传
现状/

# 运行时 SQLite 数据库 (安装向导与启动时自动免配置生成)
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
data/*.db
data/*.db-journal
data/*.lock
data/install.lock
data/install_token.txt
data/install_token.php
data/.install_throttle.json
data/prototypes/
data/chunks/
data/sessions/

# 运行时品牌上传资源 (保留目录占位)
uploads/branding/*
!uploads/branding/index.html
!uploads/branding/.gitkeep

# 临时压缩包与源文件
*.zip
*.tar.gz

# 本机工具状态、凭据与生成缓存
.cursor/mcp.json

# 生产发布包导出目录（专供上传服务器，不纳入 Git）
release/
dist/
