# 立象原型 · 用户上传资产池统一安全防御
# 仅保存 branding 品牌静态资源；原型保存在私有 data 目录

# 1. 禁止列目录与 CGI 脚本执行
Options -Indexes -ExecCGI

# 2. 严格杜绝任何动态脚本解析 (彻底防御 Webshell，兼容 Apache 2.2 / 2.4)
<FilesMatch "(?i)\.(rp|php|phtml|php3|php4|php5|php7|php8|phps|phar|sh|bash|py|pl|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. 跨域嵌入防护与 CSP 限制 (仅允许本站 iframe 嵌入)
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Content-Security-Policy "frame-ancestors 'self'"
    Header set X-Content-Type-Options "nosniff"
</IfModule>
